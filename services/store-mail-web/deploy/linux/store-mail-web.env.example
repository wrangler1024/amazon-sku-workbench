# /etc/store-mail-web/store-mail-web.env
# 权限 root:storemail 0640。这里只放服务器专属配置,完整变量说明见服务目录 .env.example。

# 主密钥(必填,不可更换,丢失=全部授权码重录)
# 生成:/opt/store-mail-web/venv/bin/python -m store_mail_web.main genkey
STORE_MAIL_WEB_SECRET_KEY=

# 监听:只绑回环,由 Nginx 反代 443
STORE_MAIL_WEB_HOST=127.0.0.1
STORE_MAIL_WEB_PORT=8789

# 管理员登录(推荐用哈希:store-mail-web hash-password 生成)
STORE_MAIL_WEB_ADMIN_USER=admin
STORE_MAIL_WEB_ADMIN_PASSWORD=
STORE_MAIL_WEB_ADMIN_PASSWORD_HASH=

# 数据库(落在独立数据目录,重建发布目录不丢)
STORE_MAIL_WEB_DB_PATH=/var/lib/store-mail-web/store_mail_web.sqlite3
# 例如：https://mail.example.com
STORE_MAIL_WEB_PUBLIC_URL=

# 同步节奏(163 对频繁连接敏感,保持默认即可)
STORE_MAIL_WEB_SYNC_INTERVAL_SECONDS=180
STORE_MAIL_WEB_SYNC_JITTER_SECONDS=40
STORE_MAIL_WEB_INITIAL_DAYS=30
STORE_MAIL_WEB_INITIAL_LIMIT=200

# Dedicated Feishu application: web login + private inbox notifications
# Configure secrets only in the deployment secret store, never in Git.
STORE_MAIL_WEB_FEISHU_APP_ID=
STORE_MAIL_WEB_FEISHU_APP_SECRET=
STORE_MAIL_WEB_FEISHU_TENANT_KEY=
