# 店铺邮箱 Web 客户端 store_mail_web
# 环境变量模板。复制为 .env 后填写，.env 不入 Git。
# 所有变量前缀 STORE_MAIL_WEB_。

# ---------- 监听 ----------
# 默认只监听本机回环，由 Nginx 反代对外提供 HTTPS；
# Docker 部署时改为 0.0.0.0（compose 已内置）。
STORE_MAIL_WEB_HOST=127.0.0.1
STORE_MAIL_WEB_PORT=8789

# ---------- 密钥（必填） ----------
# 主密钥：同时用于授权码加密(Fernet)与会话签名。
# 生成方式：store-mail-web genkey
# 一旦生成不可更换，否则已存的授权码与会话全部失效。
STORE_MAIL_WEB_SECRET_KEY=

# ---------- 管理员登录（Web 界面） ----------
STORE_MAIL_WEB_ADMIN_USER=admin
# 明文密码（方便）或 pbkdf2_sha256 哈希（推荐，store-mail-web hash-password 生成），二选一。
STORE_MAIL_WEB_ADMIN_PASSWORD=
STORE_MAIL_WEB_ADMIN_PASSWORD_HASH=
# 会话有效期（小时）
STORE_MAIL_WEB_SESSION_TTL_HOURS=12

# ---------- IMAP ----------
STORE_MAIL_WEB_IMAP_HOST=imap.163.com
STORE_MAIL_WEB_IMAP_PORT=993
STORE_MAIL_WEB_IMAP_TIMEOUT=30
# 打开邮件详情时是否回写 IMAP \Seen（默认开；关闭则只记本地已读）
STORE_MAIL_WEB_MARK_SEEN_ON_OPEN=1

# ---------- 同步节奏（163 对频繁连接敏感，勿调太小） ----------
# 每账号轮询基础间隔（秒）
STORE_MAIL_WEB_SYNC_INTERVAL_SECONDS=180
# 随机抖动上限（秒），错开各账号连接时间
STORE_MAIL_WEB_SYNC_JITTER_SECONDS=40
# 连接失败退避上限（秒），失败后按 2 倍递增
STORE_MAIL_WEB_SYNC_BACKOFF_MAX_SECONDS=1800
# 首次接入账号时回拉最近多少天的邮件
STORE_MAIL_WEB_INITIAL_DAYS=30
# 首次接入最多拉取多少封
STORE_MAIL_WEB_INITIAL_LIMIT=200
# 日常增量单次最多拉取多少封新邮件
STORE_MAIL_WEB_PER_RUN_LIMIT=100
# 手动同步最小间隔（秒），防止按钮连点触发风控
STORE_MAIL_WEB_MANUAL_SYNC_MIN_GAP_SECONDS=30

# ---------- Agent API 限流 ----------
# 每个 API Key 每分钟最大请求数（新建 Key 时可单独覆盖）
STORE_MAIL_WEB_API_RATE_PER_MIN=60

# ---------- 飞书群机器人推送（env 兜底；正式配置在 Web 设置页，存 DB） ----------
# 飞书群里 添加自定义机器人 得到 Webhook 地址；不填则只推 DB 里配置的
STORE_MAIL_WEB_FEISHU_WEBHOOK_URL=
# 机器人开了「签名校验」才需要填
STORE_MAIL_WEB_FEISHU_WEBHOOK_SECRET=
# 通知中的事件链接基址；按环境填写，不含末尾斜杠。
# 例如：https://mail.example.com。
STORE_MAIL_WEB_PUBLIC_URL=

# ---------- 存储 ----------
# SQLite 数据库路径。默认服务目录 var/ 下；Docker 内为 /app/var/。
STORE_MAIL_WEB_DB_PATH=

# Dedicated Feishu application: web login + private inbox notifications
# Configure secrets only in the deployment secret store, never in Git.
STORE_MAIL_WEB_FEISHU_APP_ID=
STORE_MAIL_WEB_FEISHU_APP_SECRET=
STORE_MAIL_WEB_FEISHU_TENANT_KEY=
