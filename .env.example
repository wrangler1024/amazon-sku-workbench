# Use a private value; never commit the actual .env file.
POSTGRES_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql://workbench:change-this-before-deployment@127.0.0.1:15439/workbench
AIGC_ENVIRONMENT=integration
AIGC_BASE_ID=EXAMPLE_INTEGRATION_BASE
AIGC_SKU_TABLE_ID=tblExampleIntegration
AIGC_PUBLIC_URL=http://127.0.0.1:8798
AIGC_FEISHU_MODE=openapi
AIGC_FEISHU_APP_ID=
AIGC_FEISHU_APP_SECRET=
AIGC_FEISHU_BASE_ORIGIN=https://example.feishu.cn
AIGC_TENANT=example
AIGC_BASE_LOGIN_ENABLED=false
AIGC_MODEL_ENABLED=false
AIGC_MODEL_TOTAL_DAILY_LIMIT=0
AIGC_MODEL_CONCURRENCY=1
AIGC_SOURCE_CONCURRENCY=1
# Set explicit approved targets and identity fields before connecting Feishu.
# AIGC_TARGETS_FILE=/run/config/targets.local.json
# Provider credentials should be entered into the server administrator page.
